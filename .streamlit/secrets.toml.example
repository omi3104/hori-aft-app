# Copy this file to .streamlit/secrets.toml for LOCAL runs,
# or paste the same keys into Streamlit Community Cloud →
# App → Settings → Secrets for the deployed app.
#
# secrets.toml itself is gitignored and must never be committed.

GROQ_API_KEY = "gsk_your_groq_key_here"
CH_API_KEY   = "your_companies_house_rest_api_key_here"
